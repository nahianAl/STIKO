# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js
AUTH_SECRET=your-random-secret-here  # generate with: openssl rand -base64 32

# REQUIRED. Also the only source of the host used in links sent by email
# (invitations, new-version notifications, password resets). It is deliberately
# never derived from the incoming request: a Host header an attacker controls
# would otherwise turn a password-reset email into account takeover.
# Without it, those emails are refused rather than sent with a guessed host.
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=stiko-uploads
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com

# Email delivery (optional). Without it, invitations, notifications and password
# resets are logged rather than sent, and the UI says so instead of claiming
# mail went out. See lib/email.ts.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=Stiko <noreply@yourdomain.com>

# AI summaries (optional). Without ATLAS_API_KEY the package and project pages
# still show the computed fact strip, and the brief area says summarisation is
# not configured rather than pretending. See lib/ai/provider.ts.
# ATLAS_API_KEY=your-atlas-cloud-key
# ATLAS_MODEL=deepseek-ai/deepseek-v4-flash   # vendor-prefixed; see GET /v1/models
# ATLAS_BASE_URL=https://api.atlascloud.ai/v1
